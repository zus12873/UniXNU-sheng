+/*
+ * A verified page-in hashes its whole verify block as it stands in memory. Where that block is larger than a page (16 KiB
+ * blocks, 4 KiB pages), pages of it may already be valid and carry a fixup, and the block no longer hashes to the sealed
+ * value. This puts the original bytes back in `copy`, a copy of [offset, offset + size) of vp, and returns the number of
+ * fixups undone; with a null copy it only counts the fixups of vp that lie in the range.
+ */
+uint32_t cs_text_fixup_restore(struct vnode *vp, off_t offset, size_t size, void *copy);
+uint32_t
+cs_text_fixup_restore(struct vnode *vp, off_t offset, size_t size, void *copy)
+{
+	uint32_t found = 0;
+	if (offset < 0 || vp == NULLVP || vp->v_name == NULL) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset < (uint64_t)offset || f->offset + f->length > (uint64_t)offset + size ||
+		    strcmp(vp->v_name, f->name) != 0) {
+			continue;
+		}
+		if (copy == NULL) {
+			found++;
+			continue;
+		}
+		uint8_t *at = (uint8_t *)copy + (f->offset - (uint64_t)offset);
+		if (memcmp(at, f->replacement, f->length) == 0) {
+			memcpy(at, f->original, f->length);
+			found++;
+		}
+	}
+	return found;
+}
